# Public URL of the site (used for canonical URLs, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://www.example.in

# Contact form email delivery (SMTP). Leave blank to disable sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address the enquiry emails are sent from and to
CONTACT_FROM="Website <no-reply@example.in>"
CONTACT_TO=

# Cloudflare Turnstile (spam protection). Leave blank to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
